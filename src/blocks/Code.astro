---
import { Code as Highlight } from 'astro:components';

const { block } = Astro.props;
---

<figure class="code">
  <figcaption class="bar">
    <span class="label">{block.filename ?? block.language}</span>
    <button type="button" class="label copy" data-copy={block.value}>copiar</button>
  </figcaption>
  <Highlight code={block.value} lang={block.language} theme="vitesse-black" />
  {block.caption && <p class="cap label">{block.caption}</p>}
</figure>

<style>
  .code {
    border: 1px solid var(--line);
    background: var(--bg-2);
    min-width: 0;
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 14px;
    border-bottom: 1px solid var(--line);
  }
  .copy {
    all: unset;
    cursor: pointer;
    font-family: var(--font-voice);
    font-size: 1.25rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-3);
  }
  .copy:hover {
    color: var(--fg);
  }
  .copy:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
  }
  .code :global(pre) {
    margin: 0;
    padding: 16px 14px;
    overflow-x: auto;
    background: transparent !important;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .cap {
    padding: 8px 14px;
    border-top: 1px solid var(--line);
    text-transform: none;
  }
</style>
