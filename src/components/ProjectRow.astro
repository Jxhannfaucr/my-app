---
import type { Project } from '@lib/content/load';
import { areaLabel, entryLabel, projectHref } from '@lib/content/derive';

/** Fila de índice: escala a decenas de proyectos sin convertirse en una pared de cards. */
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<a class="row" href={projectHref(project)}>
  <span class="no label">{entryLabel(project)}</span>
  <span class="date label">{project.date}</span>
  <span class="main">
    <span class="title voice">{project.title}</span>
    <span class="summary">{project.summary}</span>
  </span>
  <span class="areas label">{project.areas.map(areaLabel).join(' · ')}</span>
  <span class="arrow voice" aria-hidden="true">→</span>
</a>

<style>
  .row {
    display: grid;
    grid-template-columns: 56px 84px minmax(0, 1fr) auto 24px;
    gap: 6px 16px;
    align-items: baseline;
    padding: 16px 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .row:hover {
    border-top-color: var(--fg);
  }
  .no {
    color: var(--fg-2);
  }
  .main {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .title {
    font-size: 1.75rem;
    line-height: 1.1;
  }
  .summary {
    color: var(--fg-3);
    font-size: 0.9375rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .arrow {
    color: var(--fg-3);
    font-size: 1.5rem;
    transition:
      transform 0.2s var(--ease),
      color 0.2s;
  }
  .row:hover .arrow {
    transform: translateX(5px);
    color: var(--fg);
  }
  @media (max-width: 720px) {
    .row {
      grid-template-columns: 52px minmax(0, 1fr) 20px;
    }
    .date,
    .areas {
      display: none;
    }
    .main {
      grid-column: 2;
    }
  }
</style>
