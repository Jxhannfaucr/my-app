---
import { alsoKnown, techEvidence } from '@lib/content/derive';

const { rows } = techEvidence();
const also = alsoKnown();
---

<ul class="rows" data-bars>
  {
    rows.map((r) => (
      <li class="row">
        <span class="name voice">{r.name}</span>
        <span class="bar" style={`--ratio:${r.ratio}`} aria-hidden="true">
          <i />
        </span>
        <span class="count label">
          {r.projects > 0 && (
            <span>
              <span class="signal">{r.projects}</span> {r.projects === 1 ? 'proyecto' : 'proyectos'}
            </span>
          )}
          {r.roles > 0 && (
            <span>
              <span class="signal">{r.roles}</span> {r.roles === 1 ? 'rol' : 'roles'}
            </span>
          )}
        </span>
      </li>
    ))
  }
</ul>
{
  also.length > 0 && (
    <p class="also">
      <span class="label">También conozco</span>
      <span>{also.join(' · ')}</span>
    </p>
  )
}
<p class="note label">Calculado a partir de los proyectos y roles publicados.</p>

<script>
  // Las barras se dibujan al entrar en pantalla: el dato es el mensaje.
  const lists = document.querySelectorAll<HTMLElement>('[data-bars]');
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('in-view');
          io.unobserve(e.target);
        }
      }
    },
    { threshold: 0.25 },
  );
  lists.forEach((l) => io.observe(l));
</script>

<style>
  .rows {
    display: flex;
    flex-direction: column;
  }
  .row {
    display: grid;
    grid-template-columns: 170px minmax(60px, 1fr) 210px;
    gap: 6px 20px;
    align-items: center;
    padding: 9px 0;
    border-top: 1px solid var(--line);
  }
  .row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .name {
    font-size: 1.5rem;
    line-height: 1.1;
  }
  .bar {
    display: block;
    height: 6px;
    background: var(--line);
  }
  .bar i {
    display: block;
    height: 100%;
    width: calc(var(--ratio) * 100%);
    background: var(--signal);
    transform-origin: left;
    transition: transform 0.7s var(--ease);
  }
  :global(.js) .rows:not(.in-view) .bar i {
    transform: scaleX(0);
  }
  .count {
    display: flex;
    justify-content: flex-end;
    gap: 0 18px;
    white-space: nowrap;
  }
  .count span + span::before {
    content: '·';
    margin-right: 18px;
    color: var(--line-2);
  }
  .also {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 28px;
    color: var(--fg-2);
    font-size: 0.9375rem;
  }
  .note {
    margin-top: 20px;
    font-size: 1.125rem;
  }
  /* móvil: nombre y conteo en una línea, la barra debajo a todo el ancho */
  @media (max-width: 620px) {
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4px 12px;
      padding: 10px 0;
    }
    .bar {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .name {
      font-size: 1.375rem;
    }
  }
</style>
